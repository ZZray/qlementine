@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(QLEMENTINE_QT_VERSION_MAJOR "@QT_VERSION_MAJOR@")
find_dependency(Qt${QLEMENTINE_QT_VERSION_MAJOR} REQUIRED COMPONENTS Core Widgets Svg)

include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@Targets.cmake")

check_required_components(@PROJECT_NAME@)
